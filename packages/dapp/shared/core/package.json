{
  "name": "@verumlab/connect-dapp",
  "version": "0.1.0",
  "description": "Verum Connect for dapps: an EIP-1193 provider that pairs with a wallet over nostr relays.",
  "license": "MIT",
  "author": "Verum LLC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VerumLab/verum-connect.git",
    "directory": "packages/dapp/shared/core"
  },
  "homepage": "https://github.com/VerumLab/verum-connect#readme",
  "bugs": {
    "url": "https://github.com/VerumLab/verum-connect/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./surface": {
      "types": "./dist/surface.d.ts",
      "default": "./dist/surface.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist *.tsbuildinfo",
    "prepack": "node -e \"require('fs').copyFileSync('../../../../LICENSE','LICENSE')\""
  },
  "dependencies": {
    "@verumlab/connect-protocol": "0.1.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
