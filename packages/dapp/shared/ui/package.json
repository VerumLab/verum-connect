{
  "name": "@verumlab/connect-ui",
  "version": "0.1.0",
  "description": "Framework-free widgets for Verum Connect: pairing overlay, connect-code picker, relay and gateway settings.",
  "license": "MIT",
  "author": "Verum LLC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VerumLab/verum-connect.git",
    "directory": "packages/dapp/shared/ui"
  },
  "homepage": "https://github.com/VerumLab/verum-connect#readme",
  "bugs": {
    "url": "https://github.com/VerumLab/verum-connect/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
